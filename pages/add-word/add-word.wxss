/* pages/add-word/add-word.wxss */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.form-card {
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.input {
  width: 100%;
  padding: 24rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 36rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.5;
}

.input:focus {
  border-color: #4A90E2;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea:focus {
  border-color: #4A90E2;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background-color: white;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
}

.picker-text:empty::before {
  content: '请选择开始日期';
  color: #999;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

.submit-btn {
  margin-top: 40rpx;
  background-color: #4A90E2;
  color: white;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 32rpx;
}

.submit-btn:active {
  background-color: #357ABD;
}

.submit-btn[disabled] {
  background-color: #CCCCCC;
  color: #999;
}

.word-list-section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.empty-list {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
  font-size: 28rpx;
}

.word-list {
  margin-top: 10rpx;
}

.word-item {
  margin-bottom: 20rpx;
}

.word-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.word-item-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.word-item-date {
  font-size: 24rpx;
  color: #999;
  background-color: #F0F0F0;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
}

.word-item-meaning {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.word-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #F0F0F0;
}

.word-item-info {
  font-size: 24rpx;
  color: #999;
}

.delete-item-btn {
  padding: 10rpx 20rpx;
  background-color: #FF6B6B;
  color: white;
  border-radius: 6rpx;
  font-size: 24rpx;
  border: none;
}

.delete-item-btn:active {
  background-color: #EE5A5A;
}

