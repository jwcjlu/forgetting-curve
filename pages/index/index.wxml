<!--pages/index/index.wxml-->
<view class="container">
  <view class="header">
    <view class="header-content">
      <view class="header-left">
        <text class="date-title">{{todayDate}}</text>
        <text class="count-text">今日需背诵：{{todayWords.length}} 个单词</text>
      </view>
      <view class="header-right">
        <button class="settings-btn" bindtap="goToSettings" size="mini">设置</button>
      </view>
    </view>
  </view>

  <view wx:if="{{todayWords.length === 0}}" class="empty-state">
    <text class="empty-text">今天没有需要背诵的单词</text>
    <text class="empty-hint">去添加单词开始学习吧！</text>
  </view>

  <view wx:else>
    <view class="word-list">
      <view class="word-card card" wx:for="{{todayWords}}" wx:key="id" wx:for-item="wordItem">
        <!-- 浏览模式 -->
        <view wx:if="{{!wordItem.spellingMode}}">
          <view class="word-header">
            <text class="word-text">{{wordItem.word}}</text>
            <text class="review-count">第{{wordItem.reviewCount + 1}}次复习</text>
          </view>
          <view class="word-meaning">{{wordItem.meaning}}</view>
          <view class="word-info">
            <text class="info-text">开始日期：{{wordItem.startDate}}</text>
            <text class="info-text" wx:if="{{wordItem.lastReviewDate}}">上次复习：{{wordItem.lastReviewDate}}</text>
          </view>
          <view class="word-actions">
            <button class="action-btn spelling-btn" bindtap="startSpelling" data-index="{{index}}">
              开始拼写
            </button>
            <button class="action-btn review-btn" bindtap="markAsReviewed" data-id="{{wordItem.id}}">
              已复习
            </button>
            <button class="action-btn delete-btn" bindtap="deleteWord" data-id="{{wordItem.id}}">
              删除
            </button>
          </view>
        </view>

        <!-- 拼写模式 -->
        <view wx:else>
          <view class="spelling-header">
            <text class="review-count">第{{wordItem.reviewCount + 1}}次复习</text>
            <text class="spelling-hint">根据中文意思，拼写英文单词</text>
          </view>
          
          <view class="spelling-meaning">
            <text class="meaning-label">中文释义：</text>
            <text class="meaning-text">{{wordItem.meaning}}</text>
          </view>

          <view class="spelling-input-section">
            <input 
              class="spelling-input {{wordItem.showAnswer ? (wordItem.isCorrect ? 'input-correct' : 'input-wrong') : ''}}"
              type="text" 
              placeholder="请输入英文单词"
              value="{{wordItem.userAnswer}}"
              bindinput="onSpellingInput"
              data-index="{{index}}"
              disabled="{{wordItem.showAnswer}}"
              focus="{{wordItem.spellingMode && !wordItem.showAnswer}}"
              adjust-position="{{true}}"
              maxlength="50"
            />
          </view>

          <!-- 答案反馈 -->
          <view wx:if="{{wordItem.showAnswer}}" class="answer-feedback">
            <view class="feedback-result {{wordItem.isCorrect ? 'feedback-correct' : 'feedback-wrong'}}">
              <text class="feedback-icon">{{wordItem.isCorrect ? '✓' : '✗'}}</text>
              <text class="feedback-text">{{wordItem.isCorrect ? '拼写正确！' : '拼写错误'}}</text>
            </view>
            <view class="correct-answer">
              <text class="answer-label">正确答案：</text>
              <text class="answer-word">{{wordItem.word}}</text>
            </view>
          </view>

          <view class="word-actions">
            <button 
              wx:if="{{!wordItem.showAnswer}}" 
              class="action-btn check-btn" 
              bindtap="checkAnswer" 
              data-index="{{index}}"
              disabled="{{!wordItem.userAnswer || wordItem.userAnswer.trim() === ''}}"
            >
              检查答案
            </button>
            <button 
              wx:else
              class="action-btn next-btn" 
              bindtap="nextWord" 
              data-index="{{index}}"
            >
              下一个
            </button>
            <button class="action-btn back-btn" bindtap="backToView" data-index="{{index}}">
              返回查看
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

