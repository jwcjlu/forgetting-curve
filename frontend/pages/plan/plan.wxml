<!--pages/plan/plan.wxml-->
<view class="container">
  <view class="header">
    <text class="title">复习计划</text>
    <button class="create-btn" bindtap="showCreate">+ 新建计划</button>
  </view>

  <view class="plans-list" wx:if="{{!loading && plans.length > 0}}">
    <view class="plan-item" wx:for="{{plans}}" wx:key="id">
      <view class="plan-header">
        <view class="plan-info">
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-grade" wx:if="{{item.grade}}">{{item.grade}}</text>
          <text class="plan-word-count">单词数：{{item.wordCount || 0}}</text>
          <view class="active-badge" wx:if="{{item.is_active}}">
            <text>当前计划</text>
          </view>
        </view>
        <view class="plan-actions">
          <button class="action-btn select-btn" bindtap="selectPlan" data-plan-id="{{item.id}}" wx:if="{{!item.is_active}}">
            选择
          </button>
          <button class="action-btn edit-btn" bindtap="editPlan" data-plan-id="{{item.id}}">
            编辑
          </button>
          <button class="action-btn manage-btn" bindtap="managePlanWords" data-plan-id="{{item.id}}">
            添加单词
          </button>
          <button class="action-btn delete-btn" bindtap="deletePlan" data-plan-id="{{item.id}}">
            删除
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && plans.length === 0}}">
    <text class="empty-text">还没有创建任何计划</text>
    <text class="empty-hint">点击右上角"新建计划"开始创建</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- 创建计划弹窗 -->
<view class="modal" wx:if="{{showCreateModal}}" bindtap="hideCreate">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">新建复习计划</text>
      <text class="modal-close" bindtap="hideCreate">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">计划名称</text>
        <input class="form-input" placeholder="请输入计划名称" value="{{planName}}" bindinput="onPlanNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">年级</text>
        <picker mode="selector" range="{{grades}}" value="{{planGradeIndex}}" bindchange="onGradeChange">
          <view class="picker">
            {{planGrade || '请选择年级'}}
          </view>
        </picker>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel-btn" bindtap="hideCreate">取消</button>
      <button class="modal-btn confirm-btn" bindtap="createPlan">创建</button>
    </view>
  </view>
</view>

<!-- 编辑计划弹窗 -->
<view class="modal" wx:if="{{showEditModal}}" bindtap="hideEdit">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑复习计划</text>
      <text class="modal-close" bindtap="hideEdit">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">计划名称</text>
        <input class="form-input" placeholder="请输入计划名称" value="{{planName}}" bindinput="onPlanNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">年级</text>
        <picker mode="selector" range="{{grades}}" value="{{planGradeIndex}}" bindchange="onGradeChange">
          <view class="picker">
            {{planGrade || '请选择年级'}}
          </view>
        </picker>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel-btn" bindtap="hideEdit">取消</button>
      <button class="modal-btn confirm-btn" bindtap="updatePlan">保存</button>
    </view>
  </view>
</view>

