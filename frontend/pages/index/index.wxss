/* pages/index/index.wxss */
.container {
  padding: 24rpx;
  background: linear-gradient(180deg, #F8F9FA 0%, #E9ECEF 100%);
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 48rpx 36rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  color: white;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  animation: pulse 3s ease-in-out infinite;
}

.header-content {
  display: flex;
  align-items: center;
}

.header-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}


.date-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.count-text {
  font-size: 28rpx;
  opacity: 0.9;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 36rpx;
  color: #495057;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-hint {
  font-size: 28rpx;
  color: #6c757d;
  margin-top: 12rpx;
  line-height: 1.6;
}

.no-plan-state {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF4D6 100%);
  border: 2rpx solid #FFD93D;
  border-radius: 20rpx;
  padding: 80rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 217, 61, 0.2);
}

.go-plan-btn {
  margin-top: 40rpx;
  padding: 24rpx 72rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.3);
}

.go-plan-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.word-list {
  margin-top: 20rpx;
}

.word-card {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

.word-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12), 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.word-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.review-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.reviewed-badge {
  background-color: #52C41A;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.badge-text {
  font-size: 20rpx;
  color: white;
  font-weight: 500;
}

.word-text-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex: 1;
}

.word-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  overflow-x: scroll;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  word-break: keep-all;
}

.word-text.word-masked {
  font-family: 'Courier New', monospace;
  color: #999;
  letter-spacing: 4rpx;
}

.audio-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0F0F0 0%, #E8E8E8 100%);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.audio-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.audio-btn.audio-playing {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
  animation: pulse-audio 1.5s ease-in-out infinite;
}

.audio-icon {
  font-size: 32rpx;
  line-height: 1;
}

.review-count {
  font-size: 24rpx;
  color: #4A90E2;
  background-color: #E8F4FD;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.word-meaning-container {
  position: relative;
  margin-bottom: 20rpx;
}

.word-meaning {
  font-size: 32rpx;
  color: #666;
  line-height: 1.6;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
  display: block;
  overflow-x: scroll;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  word-break: keep-all;
}

.word-masked {
  font-family: 'Courier New', monospace;
  color: #999;
  letter-spacing: 4rpx;
  font-weight: bold;
}

.word-toggle-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 8rpx 15rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #E0E0E0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  z-index: 10;
}

.word-toggle-btn:active {
  background-color: #F0F0F0;
}

.toggle-icon {
  font-size: 24rpx;
}

.toggle-text {
  font-size: 22rpx;
}

.word-info {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.word-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  font-size: 28rpx;
  line-height: 1;
}

.btn-text {
  font-size: 28rpx;
}

.review-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.3);
  font-weight: 600;
}

.review-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.spelling-btn {
  background: linear-gradient(135deg, #52C41A 0%, #389E0D 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(82, 196, 26, 0.3);
  font-weight: 600;
}

.spelling-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

/* 复习模式样式 */
.masked-word-info {
  margin: 30rpx 0;
  padding: 30rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  text-align: center;
}

.masked-word {
  margin-bottom: 20rpx;
  width: 100%;
  overflow-x: scroll; /* 允许横向滚动 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
}

.masked-meaning {
  margin-top: 20rpx;
  width: 100%;
  overflow-x: scroll; /* 允许横向滚动 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
}

.masked-text {
  font-size: 40rpx;
  color: #999;
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  display: inline-block;
  max-width: 100%;
  overflow-x: scroll; /* 允许横向滚动 */
  white-space: nowrap; /* 不换行，使用横向滚动 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
  word-break: keep-all; /* 保持单词完整 */
}

/* 复习模式样式 */
.questions-section {
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
  overflow-x: visible; /* 允许内容溢出显示 */
}

.question-item {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  border-left: 6rpx solid #4A90E2;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.question-type {
  font-size: 24rpx;
  color: #4A90E2;
  background-color: #E8F4FD;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.question-content {
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

.options-section {
  margin-top: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 15rpx;
  background-color: white;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.option-item:active {
  background-color: #F0F0F0;
}

.option-selected {
  background-color: #E8F4FD;
  border-color: #4A90E2;
}

.option-correct {
  background-color: #F6FFED;
  border-color: #52C41A;
}

.option-wrong {
  background-color: #FFF1F0;
  border-color: #FF4D4F;
}

.option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A90E2;
  margin-right: 10rpx;
}

.option-text {
  font-size: 28rpx;
  color: #333;
}

.fill-blank-section {
  margin-top: 20rpx;
  width: 100%;
  padding: 0;
}

.fill-blank-input {
  width: 100%;
  min-width: 100%;
  padding: 30rpx 25rpx;
  border: 3rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 42rpx;
  background-color: white;
  box-sizing: border-box;
  letter-spacing: 3rpx; /* 增加字母间距，便于阅读 */
  font-family: 'Courier New', monospace; /* 使用等宽字体，便于拼写 */
  overflow-x: scroll; /* 允许横向滚动 */
  white-space: nowrap; /* 不换行，使用横向滚动 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
  word-break: keep-all; /* 保持单词完整 */
  min-height: 100rpx; /* 增加最小高度 */
  line-height: 1.5; /* 增加行高 */
}

.input-hint {
  display: block;
  font-size: 22rpx;
  color: #FF9800;
  margin-top: 10rpx;
  text-align: center;
  padding: 8rpx;
  background-color: #FFF7E6;
  border-radius: 4rpx;
}

.input-correct {
  background-color: #F6FFED;
  border-color: #52C41A;
}

.input-wrong {
  background-color: #FFF1F0;
  border-color: #FF4D4F;
}

/* 拼写模式样式 */
.spelling-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.spelling-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  text-align: center;
}

.spelling-meaning {
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFE7BA 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #FAAD14;
}

.meaning-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.meaning-text {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
}

.spelling-input-section {
  margin-bottom: 30rpx;
  width: 100vw;
  margin-left: calc(-30rpx - 20rpx);
  margin-right: calc(-30rpx - 20rpx);
  box-sizing: border-box;
  padding: 0 20rpx;
  position: relative;
  overflow-x: visible;
}

.spelling-input {
  width: 100%;
  padding: 35rpx 5rpx;
  border: 3rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 40rpx;
  text-align: left;
  box-sizing: border-box;
  background-color: white;
  min-height: 120rpx;
  line-height: 2;
  letter-spacing: 0.2rpx;
  word-wrap: normal;
  word-break: normal;
  overflow-wrap: normal;
  overflow-x: scroll;
  overflow-y: hidden;
  white-space: nowrap;
  display: block;
  -webkit-overflow-scrolling: touch;
}

.spelling-input:focus {
  border-color: #4A90E2;
}

.input-correct {
  border-color: #52C41A;
  background-color: #F6FFED;
}

.input-wrong {
  border-color: #FF4D4F;
  background-color: #FFF1F0;
}

.answer-feedback {
  margin-bottom: 30rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}

.feedback-result {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.feedback-correct {
  background-color: #F6FFED;
  border: 2rpx solid #52C41A;
}

.feedback-wrong {
  background-color: #FFF1F0;
  border: 2rpx solid #FF4D4F;
}

.feedback-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.feedback-correct .feedback-icon {
  color: #52C41A;
}

.feedback-wrong .feedback-icon {
  color: #FF4D4F;
}

.feedback-text {
  font-size: 32rpx;
  font-weight: 500;
}

.feedback-correct .feedback-text {
  color: #389E0D;
}

.feedback-wrong .feedback-text {
  color: #CF1322;
}

.correct-answer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
}

.answer-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 15rpx;
}

.answer-word {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}

.check-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.3);
  font-weight: 600;
}

.check-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.check-btn[disabled] {
  background-color: #CCCCCC;
  color: #999;
}

.next-btn {
  background-color: #52C41A;
  color: white;
}

.next-btn:active {
  background-color: #389E0D;
}

.regenerate-btn {
  background-color: #FF9800;
  color: white;
}

.regenerate-btn:active {
  background-color: #F57C00;
}

.action-buttons-group {
  display: flex;
  gap: 15rpx;
  width: 100%;
  flex-wrap: wrap;
}

.back-btn {
  background-color: #999;
  color: white;
}

.back-btn:active {
  background-color: #777;
}

/* 混淆词样式 */
.confused-words-section {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #FFF7E6;
  border-radius: 8rpx;
  border-left: 4rpx solid #FAAD14;
}

.confused-words-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.confused-words-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.confused-word-tag {
  display: flex;
  align-items: center;
  background-color: white;
  padding: 10rpx 15rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FAAD14;
  font-size: 24rpx;
}

.confused-word-text {
  color: #333;
  font-weight: 500;
  margin-right: 8rpx;
}

.confused-word-meaning {
  color: #666;
  font-size: 22rpx;
  margin-right: 8rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confused-word-remove {
  color: #FF4D4F;
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 5rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.confused-btn {
  background-color: #FAAD14;
  color: white;
}

.confused-btn:active {
  background-color: #D48806;
}

/* 动画效果 */
@keyframes pulse {
  0%, 100% {
    opacity: 0.3;
  }
  50% {
    opacity: 0.6;
  }
}

@keyframes pulse-audio {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

/* 添加混淆词弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #E0E0E0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  cursor: pointer;
}

.modal-body {
  padding: 30rpx;
  flex: 1;
  overflow-y: auto;
}

.search-section {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  padding: 25rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 32rpx;
  min-height: 70rpx;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

.search-btn {
  background-color: #4A90E2;
  color: white;
  padding: 0 30rpx;
}

.search-results {
  max-height: 500rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 15rpx;
}

.result-word {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  min-width: 150rpx;
}

.result-meaning {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-add-btn {
  background-color: #52C41A;
  color: white;
  padding: 0 20rpx;
}

.empty-results {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
  font-size: 28rpx;
}