<!--pages/settings/settings.wxml-->
<view class="container">
  <view class="card">
    <view class="title">学生设置</view>
    
    <view wx:if="{{!studentId && !isAutoLogin}}" class="auto-login-section">
      <text class="hint-text">点击下方按钮自动登录</text>
      <button class="btn login-btn" bindtap="tryAutoLogin" loading="{{loading}}">
        微信登录
      </button>
    </view>

    <view wx:if="{{studentId}}" class="student-info-section">
      <view class="info-item">
        <text class="info-label">学生ID：</text>
        <text class="info-value readonly">{{studentId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">学号：</text>
        <text class="info-value readonly">{{studentNo}}</text>
      </view>
    </view>

    <view wx:if="{{studentId}}" class="name-section">
      <view class="form-item">
        <text class="label">姓名</text>
        <input 
          class="input" 
          type="text"
          placeholder="请输入姓名"
          value="{{studentName}}"
          bindinput="onStudentNameInput"
          maxlength="20"
        />
      </view>
      <button class="btn" bindtap="saveStudentName" loading="{{loading}}">
        <text class="btn-icon">💾</text>
        <text class="btn-text">保存姓名</text>
      </button>
    </view>

    <view class="grade-section">
      <view class="form-item">
        <text class="label">年级选择</text>
        <picker 
          mode="selector" 
          range="{{gradeOptions}}" 
          range-key="label"
          value="{{gradeIndex}}"
          bindchange="onGradeChange"
        >
          <view class="picker-view">
            <text class="picker-text {{grade ? '' : 'picker-placeholder'}}">
              {{grade || '请选择年级'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <text class="hint-text">选择年级后，生成的题目会更符合您的学习水平</text>
    </view>


    <view class="plan-section">
      <view class="form-item">
        <text class="label">复习计划管理</text>
        <text class="hint-text">创建和管理复习计划，选择计划后只显示该计划的单词</text>
      </view>
      <button class="btn plan-btn" bindtap="goToPlans">
        <text class="btn-icon">📋</text>
        <text class="btn-text">管理计划</text>
      </button>
    </view>
  </view>
</view>
