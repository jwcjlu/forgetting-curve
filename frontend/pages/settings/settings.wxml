<!--pages/settings/settings.wxml-->
<view class="container">
  <view class="card">
    <view class="title">学生设置</view>
    
    <view wx:if="{{!studentId && !isAutoLogin}}" class="auto-login-section">
      <text class="hint-text">点击下方按钮自动登录</text>
      <button class="btn login-btn" bindtap="tryAutoLogin" loading="{{loading}}">
        微信登录
      </button>
    </view>

    <view wx:if="{{studentId}}" class="student-info-section">
      <view class="info-item">
        <text class="info-label">学生ID：</text>
        <text class="info-value">{{studentId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">姓名：</text>
        <text class="info-value">{{studentName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">学号：</text>
        <text class="info-value">{{studentNo}}</text>
      </view>
    </view>

    <view wx:if="{{studentId}}" class="manual-section">
      <view class="form-item">
        <text class="label">手动设置学生ID（可选）</text>
        <input 
          class="input" 
          type="number"
          placeholder="请输入学生ID"
          value="{{studentId}}"
          bindinput="onStudentIdInput"
        />
      </view>
      <button class="btn" bindtap="saveStudentId" loading="{{loading}}">
        保存
      </button>
    </view>

    <view class="grade-section">
      <view class="form-item">
        <text class="label">年级选择</text>
        <picker 
          mode="selector" 
          range="{{gradeOptions}}" 
          range-key="label"
          value="{{gradeIndex}}"
          bindchange="onGradeChange"
        >
          <view class="picker-view">
            <text class="picker-text {{grade ? '' : 'picker-placeholder'}}">
              {{grade || '请选择年级'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <text class="hint-text">选择年级后，生成的题目会更符合您的学习水平</text>
    </view>

    <view class="api-config-section">
      <view class="form-item">
        <text class="label">API地址</text>
        <input 
          class="input" 
          type="text"
          placeholder="请输入后端API地址"
          value="{{apiUrl}}"
          bindinput="onApiUrlInput"
        />
      </view>
      <button class="btn" bindtap="saveApiUrl" loading="{{loading}}">
        保存API地址
      </button>
    </view>
  </view>
</view>
