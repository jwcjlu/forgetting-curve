/* pages/settings/settings.wxss */
.container {
  padding: 20rpx;
}

.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.auto-login-section {
  text-align: center;
  padding: 40rpx 0;
}

.hint-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  display: block;
}

.login-btn {
  background-color: #07C160;
  color: white;
}

.login-btn:active {
  background-color: #06AD56;
}

.student-info-section {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.manual-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.api-config-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.input {
  width: 100%;
  padding: 30rpx 25rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 36rpx;
  box-sizing: border-box;
  min-height: 90rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

.btn {
  width: 100%;
  padding: 24rpx;
  background-color: #4A90E2;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  border: none;
}

.btn:active {
  background-color: #357ABD;
}
