/* pages/settings/settings.wxss */
.container {
  padding: 24rpx;
  background: linear-gradient(180deg, #F8F9FA 0%, #E9ECEF 100%);
  min-height: 100vh;
}

.card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.auto-login-section {
  text-align: center;
  padding: 40rpx 0;
}

.hint-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  display: block;
}

.login-btn {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
  font-weight: 600;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.student-info-section {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 8rpx;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.info-value.readonly {
  color: #999;
  font-weight: normal;
}

.name-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.grade-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.picker-view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 30rpx 25rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background-color: white;
  min-height: 90rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 36rpx;
  color: #333;
  flex: 1;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 20rpx;
}

.plan-section {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #E0E0E0;
}

.plan-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  font-weight: 600;
}

.plan-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}


.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.input {
  width: 100%;
  padding: 30rpx 25rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 36rpx;
  box-sizing: border-box;
  min-height: 90rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

.btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}
